# Copy to .env (never commit .env). Cloud builds (Appflow) set these in their
# Environment instead.

# Cloudflare Worker that holds the Gemini API key (see cloudflare-worker/worker.js).
VITE_PROXY_URL=https://<worker>.workers.dev

# Must match the worker's APP_TOKEN secret. Sent as the X-App-Token header.
VITE_APP_TOKEN=
