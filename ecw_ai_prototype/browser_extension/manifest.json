{
  "manifest_version": 3,
  "name": "eCW Ambient AI Assistant",
  "version": "1.0",
  "description": "Extracts patient data from eClinicalWorks Web and sends it to a local Gemma4 model.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*.eclinicalworks.com/*",
    "https://*.eclinicalweb.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.eclinicalworks.com/*", "https://*.eclinicalweb.com/*", "http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ]
}
